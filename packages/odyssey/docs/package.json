{
  "name": "@odyssey/docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./headless": "./src/headless.ts",
    "./mdx-runtime": "./src/mdx-runtime.ts",
    "./plugin": "./src/plugin.ts",
    "./locale": "./src/locale.tsx",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "typecheck": "tsc -b --noEmit",
    "lint:fix": "tsc -b --noEmit && biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "tsc -b --noEmit && biome check . && bun run architecture:check",
    "architecture:check": "bun scripts/validate-architecture.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@odyssey/ui": "workspace:*",
    "@bprogress/react": "^1.2.7",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "github-slugger": "^1.5.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.17.0",
    "lucide-react": "catalog:",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.15.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zustand": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@odyssey/design-devconfig": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "^24.12.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT"
}
